---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  tagline: string;
  year: string;
  institution?: string;
  publication?: string;
  tech?: string[];
  hero?: ImageMetadata;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const {
  title,
  tagline,
  year,
  institution,
  publication,
  tech,
  hero,
  prev,
  next,
} = Astro.props;
---

<BaseLayout title={title} description={tagline}>
  <article class="pt-12 md:pt-20">
    <div class="max-w-[80rem] mx-auto px-6 md:px-10 lg:px-16">
      <a href="/#engineering" class="text-[14px] text-muted hover:text-ink transition-colors inline-flex items-center gap-1.5">
        <span aria-hidden="true">←</span> Engineering Background
      </a>

      <header class="mt-10 md:mt-16 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-7">
          <p class="eyebrow">{tagline}</p>
          <h1 class="display-1 mt-4">{title}</h1>
        </div>
        <div class="md:col-span-5 md:pt-3 flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-x-6 gap-y-3">
            <div>
              <p class="text-faint text-[12px] uppercase tracking-wide">Year</p>
              <p class="text-ink text-[14px] mt-1">{year}</p>
            </div>
            {institution && (
              <div>
                <p class="text-faint text-[12px] uppercase tracking-wide">Institution</p>
                <p class="text-ink text-[14px] mt-1">{institution}</p>
              </div>
            )}
            {publication && (
              <div class="col-span-2">
                <p class="text-faint text-[12px] uppercase tracking-wide">Publication</p>
                <p class="text-ink text-[14px] mt-1">{publication}</p>
              </div>
            )}
          </div>
          {tech && tech.length > 0 && (
            <div>
              <p class="text-faint text-[12px] uppercase tracking-wide mb-2">Tech &amp; tools</p>
              <ul class="flex flex-wrap gap-2">
                {tech.map((t) => (
                  <li class="text-[12px] tracking-wide uppercase text-faint border border-hairline rounded-full px-3 py-1">
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </header>

      {hero && (
        <div class="mt-14 md:mt-24 bg-[#EFEEEC] overflow-hidden">
          <Image
            src={hero}
            alt={`${title} hero`}
            widths={[800, 1200, 1600, 2000, 2400]}
            sizes="(min-width: 1280px) 1280px, 100vw"
            quality={92}
            class="w-full h-auto"
          />
        </div>
      )}

      <div class="mt-14 md:mt-24 grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-8 md:col-start-3">
          <div class="prose-body">
            <slot />
          </div>
        </div>
      </div>
    </div>

    <nav class="mt-32 md:mt-48 border-t border-hairline">
      <div class="max-w-[80rem] mx-auto px-6 md:px-10 lg:px-16 py-12 grid grid-cols-2 gap-8">
        <div>
          {prev && (
            <a href={`/engineering/${prev.slug}`} class="group block">
              <p class="eyebrow">Previous</p>
              <p class="display-3 mt-2 group-hover:text-accent transition-colors">{prev.title}</p>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={`/engineering/${next.slug}`} class="group block">
              <p class="eyebrow">Next</p>
              <p class="display-3 mt-2 group-hover:text-accent transition-colors">{next.title}</p>
            </a>
          )}
        </div>
      </div>
    </nav>
  </article>
</BaseLayout>
